API_BASE_URL=http://localhost:8080

# OAuth (KAN-257) — client_id는 인가 URL에 그대로 노출되는 공개 식별자(비밀 아님).
# redirect_uri는 프로바이더 콘솔에 등록된 값과 일치해야 하며, 배포 환경에선 실제 도메인으로 교체.
KAKAO_CLIENT_ID=752deab2b43926bae8df113064136f49
GOOGLE_CLIENT_ID=84536561616-ted50fuc0vjrmqfsitdfhoo6hq0ihvnc.apps.googleusercontent.com
# Apple Services ID (KAN-395) — appleid.apple.com의 Services ID(예: co.plick.web).
# HTTPS 콜백만 받으므로 로컬(http)에선 시작 URL 조립까지만 되고 인가 왕복은 dev 배포에서만 성립.
APPLE_CLIENT_ID=
OAUTH_REDIRECT_URI=http://localhost:3001/oauth/callback

# 사이트 대표 URL (KAN-346) — metadataBase·canonical·sitemap 등 서버가 절대 origin을 알아야 하는
# SEO 용도 전용. 공유 링크는 ADR 0047대로 window.location.origin을 유지한다.
# NEXT_PUBLIC_ 접두사라 빌드 시점에 산출물로 굳는다. 배포 값은 deploy.yml 빌드 스텝에 있다(https://m.plick.co.kr).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 데스크톱 웹 대표 URL (KAN-346) — 모바일 페이지의 canonical이 가리키는 곳(별도 모바일 URL 패턴).
# 배포 값은 deploy.yml 빌드 스텝에 있다(https://plick.co.kr).
NEXT_PUBLIC_WEB_SITE_URL=http://localhost:3000
