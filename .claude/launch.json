{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "exec", "next", "dev"],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "mobile-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "mobile", "exec", "next", "start"],
      "port": 3101,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "exec", "next", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "exec", "next", "start"],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "mobile-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_BASE_URL=http://localhost:8081",
        "pnpm",
        "--filter",
        "mobile",
        "exec",
        "next",
        "start",
        "--port",
        "3011"
      ],
      "port": 3011,
      "autoPort": true
    },
    {
      "name": "web-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_BASE_URL=http://localhost:8081",
        "pnpm",
        "--filter",
        "web",
        "exec",
        "next",
        "start",
        "--port",
        "3010"
      ],
      "port": 3010,
      "autoPort": true
    }
  ]
}
