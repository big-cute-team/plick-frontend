{
  "title": "PR 헤드리스 리뷰 결과",
  "type": "object",
  "required": ["summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "description": "변경의 의도와 전체 인상 두세 문장"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "file", "reason"],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": ["CRITICAL", "WARN", "INFO"]
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": ["integer", "null"]
          },
          "reason": {
            "type": "string",
            "description": "왜 문제인지, 근거가 되는 코드"
          },
          "suggestion": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
