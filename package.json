{
  "name": "plick",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "test:hooks": "node --test tests/hooks/*.test.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --import ./tests/unit/register.mjs --test tests/unit/*.test.mjs",
    "test:e2e": "pnpm --filter @plick/e2e test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
